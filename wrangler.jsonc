{
  "name": "atlas-sfn",
  "account_id": "6ccbe082f3fa9ddc0f0a94efbdf7f6b5",
  "compatibility_date": "2026-07-11",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "TOMACONTA_DB",
      "database_name": "tomaconta-shared",
      "database_id": "78f1ce64-f219-44af-a745-f9f086346aa2"
    }
  ],
  "r2_buckets": [
    {
      "binding": "TOMACONTA_BUCKET",
      "bucket_name": "tomaconta-shared"
    }
  ]
}
